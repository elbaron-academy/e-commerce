# Local development settings. `make backend-install` copies this to backend/.env.

DEBUG=true
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite for now. Switch to Postgres later with e.g.
# DATABASE_URL=postgres://rocket:secret@localhost:5432/rocket
DATABASE_URL=sqlite:///db.sqlite3

# Browser origins allowed to call the API (storefront, admin dashboard)
CORS_ALLOWED_ORIGINS=http://localhost:3000
STOREFRONT_URL=http://localhost:3000

# Login code is always 1234 in development (no SMS is sent)
OTP_FIXED_CODE=1234

# Payments: "dummy" sends customers to the storefront's test payment page
PAYMENT_PROVIDER=dummy
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Optional: Redis for cache and background jobs (otherwise file cache + inline jobs)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

# Optional
# STAFF_ALERT_EMAILS=ops@example.com
# SENTRY_DSN=
