# Where the storefront calls the API. Default: the built-in mock under /api/v1.
# Real backend: NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1 and NUXT_MOCK_API=false
NUXT_PUBLIC_API_BASE=/api/v1
# Optional: API URL used during server-side rendering (same machine / Docker network).
# NUXT_API_BASE_SERVER=http://127.0.0.1:8000/api/v1
# Public URL of the site (canonical links, hreflang, Open Graph).
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to false when the Django backend is live, so the mock API stops answering.
NUXT_MOCK_API=true
