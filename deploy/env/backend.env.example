# Production settings for the API. server-setup.sh copies this to /opt/rocket/.env
# once and fills in the generated secrets. Edit /opt/rocket/.env on the server, never in git.

DEBUG=false
SECRET_KEY=__GENERATED__
ALLOWED_HOSTS=api.rocket.hossam-ameen.online,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://api.rocket.hossam-ameen.online
CORS_ALLOWED_ORIGINS=https://rocket.hossam-ameen.online
NUM_PROXIES=1

# SQLite for now
DATABASE_URL=sqlite:////opt/rocket/data/db.sqlite3
CACHE_DIR=/opt/rocket/data/cache
MEDIA_ROOT=/opt/rocket/media
MEDIA_URL=https://api.rocket.hossam-ameen.online/media/
STATIC_ROOT=/opt/rocket/static

STOREFRONT_URL=https://rocket.hossam-ameen.online
OTP_WEBOTP_DOMAIN=rocket.hossam-ameen.online

# DEMO ONLY: every login code is 1234 until an SMS provider is connected.
# Delete this line once SMS_BACKEND points to a real provider.
OTP_FIXED_CODE=1234

PAYMENT_PROVIDER=dummy
PAYMENT_WEBHOOK_SECRET=__GENERATED__

# Load the demo catalog on the first deploy (only while there are no products).
SEED_DEMO=true

# Optional
STAFF_ALERT_EMAILS=
SENTRY_DSN=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
