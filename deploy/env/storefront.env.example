# Production settings for the storefront. server-setup.sh copies this to /opt/rocket/storefront.env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
NUXT_PUBLIC_SITE_URL=https://rocket.hossam-ameen.online
NUXT_PUBLIC_API_BASE=https://api.rocket.hossam-ameen.online/api/v1
# Server-side rendering talks to the API directly on this machine.
NUXT_API_BASE_SERVER=http://127.0.0.1:8000/api/v1
NUXT_MOCK_API=false
