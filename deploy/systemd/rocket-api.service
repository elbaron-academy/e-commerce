[Unit]
Description=Rocket Market API (Django + gunicorn)
ConditionPathExists=/opt/rocket/backend/manage.py
After=network.target

[Service]
Type=simple
User=__USER__
Group=www-data
WorkingDirectory=/opt/rocket/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=DJANGO_ENV_FILE=/opt/rocket/.env
# GUNICORN_WORKERS / GUNICORN_THREADS (default 1 / 1) can be set in /opt/rocket/.env
EnvironmentFile=-/opt/rocket/.env
ExecStart=/opt/rocket/venv/bin/gunicorn config.wsgi:application --config python:config.gunicorn
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
UMask=0022

[Install]
WantedBy=multi-user.target
