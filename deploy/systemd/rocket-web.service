[Unit]
Description=Rocket Market storefront (Nuxt server)
ConditionPathExists=/var/www/html/rocket/current/server/index.mjs
After=network.target rocket-api.service

[Service]
Type=simple
User=__USER__
Group=www-data
WorkingDirectory=/var/www/html/rocket/current
EnvironmentFile=/opt/rocket/storefront.env
ExecStart=/usr/bin/env node /var/www/html/rocket/current/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
